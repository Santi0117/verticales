# Copiá este archivo como .env.local (en tu compu) o cargá estas variables en
# Vercel → Settings → Environment Variables. Ninguna hace falta para ver la página.

# ── Cobro con Onvo ───────────────────────────────────────────────────────────
# Sin esta llave el botón Pagar muestra "Onvo no está configurado" y no cobra.
ONVO_SECRET_KEY=

# URL pública de este sitio: a dónde vuelve el cliente desde el checkout.
# En Vercel se deduce sola; ponela cuando tengas el dominio definitivo.
NEXT_PUBLIC_SITE_URL=

# ── A dónde va el cliente después de pagar ───────────────────────────────────
# La app de cada vertical. Sin estas variables el código cae en localhost,
# que solo sirve en tu compu. Estas son las que hoy responden en producción.
NEXT_PUBLIC_APP_RESTAURANTES_URL=https://resta.onvisiondigital.com
NEXT_PUBLIC_APP_RETAIL_URL=https://retail.onvisiondigital.com
NEXT_PUBLIC_APP_CLINICAS_URL=https://salud.onvisiondigital.com
NEXT_PUBLIC_APP_ABOGADOS_URL=https://legal.onvisiondigital.com
NEXT_PUBLIC_APP_CONSTRUCTORAS_URL=https://obras.onvisiondigital.com
NEXT_PUBLIC_APP_BIENES_RAICES_URL=https://inmo.onvisiondigital.com
NEXT_PUBLIC_APP_GANADERIA_URL=https://ganadero.onvisiondigital.com
NEXT_PUBLIC_APP_AGRICULTURA_URL=https://agricola.onvisiondigital.com
NEXT_PUBLIC_APP_TALLERES_URL=https://taller.onvisiondigital.com
NEXT_PUBLIC_APP_PERSONAL_URL=https://personal.onvisiondigital.com
